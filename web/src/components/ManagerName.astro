---
// A manager's display name from their canonical id, optionally linked to their profile.
// Leave `link` off inside something that is already a link (cards, record holders).
import { manager, managerHref } from "../lib/data";

interface Props {
  id: string;
  /** Use the short name, for tight tables. */
  short?: boolean;
  link?: boolean;
}

const { id, short = false, link = false } = Astro.props;
const m = manager(id);
const text = short ? m.short_name : m.name;
const title = short ? m.name : undefined;
---

{
  link ? (
    <a class="manager" href={managerHref(id)} title={title}>
      {text}
    </a>
  ) : (
    <span class="manager" title={title}>
      {text}
    </span>
  )
}
