---
// One record from the records book: the holder up top, then the rest of the top 10.
import ManagerName from "./ManagerName.astro";

export interface Mark {
  /** One manager, or two for a matchup. */
  who: string[];
  value: string;
  /** Where and when, e.g. "2019 · week 5". */
  when: string;
  href: string;
  /** Set in the season in progress, or a streak still running. */
  live?: boolean;
  detail?: string;
}

interface Props {
  id: string;
  title: string;
  note?: string;
  marks: Mark[];
}

const { id, title, note, marks } = Astro.props;
const [top, ...rest] = marks;
---

<article class="card record" id={id}>
  <h3><a href={`#${id}`}>{title}</a></h3>
  {
    top && (
      <a class="holder" href={top.href}>
        <span class="value num">{top.value}</span>
        <span class="who">
          {top.who.length === 0 && "Whole league"}
          {top.who.map((w, i) => (
            <>
              {i > 0 && " vs "}
              <ManagerName id={w} />
            </>
          ))}
          {top.live && <span class="badge live">Live</span>}
        </span>
        <span class="muted small">
          {top.when}
          {top.detail && ` · ${top.detail}`}
        </span>
      </a>
    )
  }
  {note && <p class="muted small note">{note}</p>}
  {
    rest.length > 0 && (
      <ol start="2">
        {rest.map((m) => (
          <li>
            <span class="num v">{m.value}</span>
            <span class="w">
              {m.who.map((w, i) => (
                <>
                  {i > 0 && " vs "}
                  <ManagerName id={w} short />
                </>
              ))}
              {m.live && <span class="badge live">Live</span>}
            </span>
            <a class="small" href={m.href}>
              {m.when}
            </a>
          </li>
        ))}
      </ol>
    )
  }
</article>

<style>
  .record h3 {
    font-size: var(--step-0);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .record h3 a {
    color: inherit;
    text-decoration: none;
  }
  .record:target {
    border-color: var(--accent);
  }
  .holder {
    display: flex;
    flex-direction: column;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 0.5rem;
  }
  .holder .value {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.1;
    color: var(--accent);
  }
  .holder .who {
    font-weight: 600;
  }
  .holder:hover .who {
    text-decoration: underline;
  }
  .badge.live {
    margin-left: 0.4rem;
  }
  .note {
    margin-bottom: 0.5rem;
  }
  ol {
    margin: 0;
    padding: 0.5rem 0 0 1.4rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }
  li {
    padding: 0.15rem 0;
  }
  li::marker {
    color: var(--muted);
  }
  li > * {
    vertical-align: baseline;
  }
  .v {
    display: inline-block;
    min-width: 4.2em;
    font-weight: 600;
  }
  .w {
    margin-right: 0.4rem;
  }
  li a {
    color: var(--muted);
  }
</style>
