# Copy to .env (gitignored) and fill in. In CI these come from GitHub Actions secrets.

# ESPN league to operate on. 763471 is Mustafa Greene's Fan Club, the only league the hub ships.
# Other leagues the same cookies can read: 651125867 (Dickey), 1158588190 (Faustyn).
LEAGUE_ID=763471

# ESPN auth cookies. To get them:
#   1. Log in at https://fantasy.espn.com in a desktop browser.
#   2. Open devtools -> Application (Chrome/Edge) or Storage (Firefox) -> Cookies -> https://fantasy.espn.com
#   3. Copy the values of `SWID` (keep the braces) and `espn_s2`.
# espn_s2 may be pasted URL-encoded (with %2B, %2F) or decoded; config.py normalizes it.
# These expire every few months; a 401 from lm-api-reads.fantasy.espn.com means refresh them.
ESPN_SWID={00000000-0000-0000-0000-000000000000}
ESPN_S2=

# Secret key that turns SWIDs into the opaque manager IDs (m_xxxxxxxxxxxxxxxx) stored in data/raw/.
# Must stay the same forever, or newly fetched seasons will not join with committed ones.
# Get the real value from the repo owner; never generate a new one for an existing data/raw/.
MANAGER_ID_KEY=
