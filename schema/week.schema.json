{
  "$defs": {
    "AllPlayCellOut": {
      "additionalProperties": false,
      "description": "One team's NFL week in the all-play grid.",
      "properties": {
        "losses": {
          "title": "Losses",
          "type": "integer"
        },
        "opponent": {
          "title": "Opponent",
          "type": "string"
        },
        "opponent_points": {
          "title": "Opponent Points",
          "type": "number"
        },
        "points": {
          "title": "Points",
          "type": "number"
        },
        "rank": {
          "description": "Where the score ranked that week, 1 = highest",
          "title": "Rank",
          "type": "integer"
        },
        "result": {
          "description": "The real game's result",
          "enum": [
            "W",
            "L",
            "T"
          ],
          "title": "Result",
          "type": "string"
        },
        "ties": {
          "title": "Ties",
          "type": "integer"
        },
        "wins": {
          "description": "All-play that week: teams outscored",
          "title": "Wins",
          "type": "integer"
        }
      },
      "required": [
        "points",
        "opponent",
        "opponent_points",
        "result",
        "rank",
        "wins",
        "losses",
        "ties"
      ],
      "title": "AllPlayCellOut",
      "type": "object"
    },
    "AllPlayGridOut": {
      "additionalProperties": false,
      "description": "All-play week by week through the report's week (regular season), and luck: the v0 Records panel.",
      "properties": {
        "periods": {
          "description": "Final regular season NFL weeks through this week",
          "items": {
            "type": "integer"
          },
          "title": "Periods",
          "type": "array"
        },
        "rows": {
          "description": "Best all-play pct first",
          "items": {
            "$ref": "#/$defs/AllPlayRowOut"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "periods",
        "rows"
      ],
      "title": "AllPlayGridOut",
      "type": "object"
    },
    "AllPlayRowOut": {
      "additionalProperties": false,
      "properties": {
        "all_play_losses": {
          "title": "All Play Losses",
          "type": "integer"
        },
        "all_play_pct": {
          "title": "All Play Pct",
          "type": "number"
        },
        "all_play_ties": {
          "title": "All Play Ties",
          "type": "integer"
        },
        "all_play_wins": {
          "description": "Against every other team, every final regular season week",
          "title": "All Play Wins",
          "type": "integer"
        },
        "cells": {
          "description": "Aligned with AllPlayGridOut.periods",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/AllPlayCellOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Cells",
          "type": "array"
        },
        "losses": {
          "title": "Losses",
          "type": "integer"
        },
        "luck": {
          "description": "win_pct - all_play_pct: positive means the schedule was kind",
          "title": "Luck",
          "type": "number"
        },
        "luck_wins": {
          "description": "Actual wins minus wins at the all-play rate over the same games",
          "title": "Luck Wins",
          "type": "number"
        },
        "manager": {
          "title": "Manager",
          "type": "string"
        },
        "ties": {
          "title": "Ties",
          "type": "integer"
        },
        "win_pct": {
          "title": "Win Pct",
          "type": "number"
        },
        "wins": {
          "description": "Regular season",
          "title": "Wins",
          "type": "integer"
        }
      },
      "required": [
        "manager",
        "wins",
        "losses",
        "ties",
        "win_pct",
        "all_play_wins",
        "all_play_losses",
        "all_play_ties",
        "all_play_pct",
        "luck",
        "luck_wins",
        "cells"
      ],
      "title": "AllPlayRowOut",
      "type": "object"
    },
    "BenchLineOut": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "description": "Weeks with points left on the bench, most first",
          "items": {
            "$ref": "#/$defs/BenchWeekOut"
          },
          "title": "Detail",
          "type": "array"
        },
        "left_on_bench": {
          "title": "Left On Bench",
          "type": "number"
        },
        "manager": {
          "title": "Manager",
          "type": "string"
        },
        "perfect_weeks": {
          "title": "Perfect Weeks",
          "type": "integer"
        },
        "substitutions": {
          "title": "Substitutions",
          "type": "integer"
        },
        "weeks": {
          "description": "NFL weeks counted through this week",
          "title": "Weeks",
          "type": "integer"
        }
      },
      "required": [
        "manager",
        "weeks",
        "left_on_bench",
        "substitutions",
        "perfect_weeks",
        "detail"
      ],
      "title": "BenchLineOut",
      "type": "object"
    },
    "BenchWeekOut": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "title": "Actual",
          "type": "number"
        },
        "left_on_bench": {
          "title": "Left On Bench",
          "type": "number"
        },
        "optimal": {
          "title": "Optimal",
          "type": "number"
        },
        "period": {
          "description": "NFL week",
          "title": "Period",
          "type": "integer"
        },
        "swaps": {
          "description": "The lineup changes that would have made it optimal, biggest first",
          "items": {
            "$ref": "#/$defs/SwapOut"
          },
          "title": "Swaps",
          "type": "array"
        }
      },
      "required": [
        "period",
        "actual",
        "optimal",
        "left_on_bench",
        "swaps"
      ],
      "title": "BenchWeekOut",
      "type": "object"
    },
    "FlagOut": {
      "additionalProperties": false,
      "properties": {
        "holder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holder"
        },
        "kind": {
          "enum": [
            "streak",
            "lopsided",
            "dead_even"
          ],
          "title": "Kind",
          "type": "string"
        },
        "losses": {
          "default": 0,
          "title": "Losses",
          "type": "integer"
        },
        "wins": {
          "default": 0,
          "title": "Wins",
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "FlagOut",
      "type": "object"
    },
    "MissedStartOut": {
      "additionalProperties": false,
      "properties": {
        "gain": {
          "description": "Points those starts would have added",
          "title": "Gain",
          "type": "number"
        },
        "manager": {
          "title": "Manager",
          "type": "string"
        },
        "player": {
          "title": "Player",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "string"
        },
        "weeks": {
          "description": "Weeks he should have started and didn't",
          "title": "Weeks",
          "type": "integer"
        }
      },
      "required": [
        "manager",
        "player",
        "position",
        "weeks",
        "gain"
      ],
      "title": "MissedStartOut",
      "type": "object"
    },
    "PickValueOut": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "description": "That season's line for this pick",
          "title": "Expected",
          "type": "number"
        },
        "manager": {
          "title": "Manager",
          "type": "string"
        },
        "overall_pick": {
          "title": "Overall Pick",
          "type": "integer"
        },
        "player": {
          "title": "Player",
          "type": "string"
        },
        "points": {
          "description": "The player's season in this league's scoring",
          "title": "Points",
          "type": "number"
        },
        "points_above_avg": {
          "description": "Points minus the mean of drafted players at his position",
          "title": "Points Above Avg",
          "type": "number"
        },
        "position": {
          "title": "Position",
          "type": "string"
        },
        "round": {
          "title": "Round",
          "type": "integer"
        },
        "round_pick": {
          "title": "Round Pick",
          "type": "integer"
        },
        "season": {
          "title": "Season",
          "type": "integer"
        },
        "value": {
          "description": "points_above_avg - expected: points above what the pick promised",
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "season",
        "round",
        "round_pick",
        "overall_pick",
        "manager",
        "player",
        "position",
        "points",
        "points_above_avg",
        "expected",
        "value"
      ],
      "title": "PickValueOut",
      "type": "object"
    },
    "PlayerPointsOut": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "points": {
          "title": "Points",
          "type": "number"
        },
        "position": {
          "title": "Position",
          "type": "string"
        }
      },
      "required": [
        "name",
        "position",
        "points"
      ],
      "title": "PlayerPointsOut",
      "type": "object"
    },
    "RecapOut": {
      "additionalProperties": false,
      "description": "One game of the week retold in rivalry context (stats/narrative.py).",
      "properties": {
        "away": {
          "title": "Away",
          "type": "string"
        },
        "first_meeting": {
          "title": "First Meeting",
          "type": "boolean"
        },
        "flags": {
          "description": "Notable flags on the series after the game (league_rules.yml)",
          "items": {
            "$ref": "#/$defs/FlagOut"
          },
          "title": "Flags",
          "type": "array"
        },
        "home": {
          "title": "Home",
          "type": "string"
        },
        "losses": {
          "title": "Losses",
          "type": "integer"
        },
        "manager": {
          "description": "The side the record and streak are from: the winner (home on a tie)",
          "title": "Manager",
          "type": "string"
        },
        "streak": {
          "$ref": "#/$defs/StreakOut",
          "description": "The series' current streak after the game"
        },
        "text": {
          "description": "Prose; managers appear as @[id] tokens for the site to link",
          "title": "Text",
          "type": "string"
        },
        "ties": {
          "title": "Ties",
          "type": "integer"
        },
        "wins": {
          "description": "The series after the game, from manager's side",
          "title": "Wins",
          "type": "integer"
        }
      },
      "required": [
        "home",
        "away",
        "text",
        "first_meeting",
        "manager",
        "wins",
        "losses",
        "ties",
        "streak",
        "flags"
      ],
      "title": "RecapOut",
      "type": "object"
    },
    "StandingLineOut": {
      "additionalProperties": false,
      "properties": {
        "losses": {
          "title": "Losses",
          "type": "integer"
        },
        "manager": {
          "title": "Manager",
          "type": "string"
        },
        "points_against": {
          "title": "Points Against",
          "type": "number"
        },
        "points_for": {
          "title": "Points For",
          "type": "number"
        },
        "ties": {
          "title": "Ties",
          "type": "integer"
        },
        "wins": {
          "title": "Wins",
          "type": "integer"
        }
      },
      "required": [
        "manager",
        "wins",
        "losses",
        "ties",
        "points_for",
        "points_against"
      ],
      "title": "StandingLineOut",
      "type": "object"
    },
    "StreakOut": {
      "additionalProperties": false,
      "properties": {
        "holder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when the last meeting was a tie",
          "title": "Holder"
        },
        "length": {
          "title": "Length",
          "type": "integer"
        }
      },
      "required": [
        "holder",
        "length"
      ],
      "title": "StreakOut",
      "type": "object"
    },
    "SwapOut": {
      "additionalProperties": false,
      "properties": {
        "gain": {
          "title": "Gain",
          "type": "number"
        },
        "player_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlayerPointsOut"
            },
            {
              "type": "null"
            }
          ],
          "description": "Benched player who should have started"
        },
        "player_out": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlayerPointsOut"
            },
            {
              "type": "null"
            }
          ],
          "description": "Starter he'd have replaced (null: an empty slot)"
        }
      },
      "required": [
        "player_in",
        "player_out",
        "gain"
      ],
      "title": "SwapOut",
      "type": "object"
    },
    "WeekCoachingOut": {
      "additionalProperties": false,
      "description": "Lineup decisions through the week (from 2018): the v0 report's Coaching panel.",
      "properties": {
        "bench": {
          "description": "Most points left on the bench first",
          "items": {
            "$ref": "#/$defs/BenchLineOut"
          },
          "title": "Bench",
          "type": "array"
        },
        "by_manager": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/MissedStartOut"
            },
            "type": "array"
          },
          "description": "Each manager's biggest missed starts",
          "title": "By Manager",
          "type": "object"
        },
        "if_only": {
          "description": "The league's biggest missed starts, top 10",
          "items": {
            "$ref": "#/$defs/MissedStartOut"
          },
          "title": "If Only",
          "type": "array"
        }
      },
      "required": [
        "bench",
        "if_only",
        "by_manager"
      ],
      "title": "WeekCoachingOut",
      "type": "object"
    },
    "WeekDraftOut": {
      "additionalProperties": false,
      "description": "The draft graded on points so far (from 2018): the v0 report's Draft panel, plus its regression.",
      "properties": {
        "busts": {
          "description": "Smallest value through round busts_through_round, top 10",
          "items": {
            "$ref": "#/$defs/PickValueOut"
          },
          "title": "Busts",
          "type": "array"
        },
        "busts_through_round": {
          "title": "Busts Through Round",
          "type": "integer"
        },
        "intercept": {
          "description": "The draft's line: expected points_above_avg = intercept + slope * pick",
          "title": "Intercept",
          "type": "number"
        },
        "picks": {
          "description": "Every non-keeper pick, by overall pick",
          "items": {
            "$ref": "#/$defs/PickValueOut"
          },
          "title": "Picks",
          "type": "array"
        },
        "slope": {
          "title": "Slope",
          "type": "number"
        },
        "steals": {
          "description": "Biggest value after round steals_after_round, top 10",
          "items": {
            "$ref": "#/$defs/PickValueOut"
          },
          "title": "Steals",
          "type": "array"
        },
        "steals_after_round": {
          "title": "Steals After Round",
          "type": "integer"
        }
      },
      "required": [
        "steals_after_round",
        "busts_through_round",
        "intercept",
        "slope",
        "picks",
        "steals",
        "busts"
      ],
      "title": "WeekDraftOut",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One weekly report, everything as it stood when the week ended (\"through week N\").",
  "properties": {
    "all_play": {
      "$ref": "#/$defs/AllPlayGridOut"
    },
    "coaching": {
      "anyOf": [
        {
          "$ref": "#/$defs/WeekCoachingOut"
        },
        {
          "type": "null"
        }
      ],
      "description": "null before 2018: ESPN kept no bench data"
    },
    "columns": {
      "default": [
        "season",
        "week",
        "tier",
        "home",
        "away",
        "home_score",
        "away_score",
        "winner"
      ],
      "items": {
        "type": "string"
      },
      "title": "Columns",
      "type": "array"
    },
    "draft": {
      "anyOf": [
        {
          "$ref": "#/$defs/WeekDraftOut"
        },
        {
          "type": "null"
        }
      ],
      "description": "null before 2018: ESPN kept no weekly player points"
    },
    "games": {
      "description": "This week's games",
      "items": {
        "maxItems": 8,
        "minItems": 8,
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        ],
        "type": "array"
      },
      "title": "Games",
      "type": "array"
    },
    "headlines": {
      "description": "High and low score, closest game, biggest blowout (@[id] tokens)",
      "items": {
        "type": "string"
      },
      "title": "Headlines",
      "type": "array"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "periods": {
      "description": "The NFL weeks this matchup week covers",
      "items": {
        "type": "integer"
      },
      "title": "Periods",
      "type": "array"
    },
    "playoff": {
      "title": "Playoff",
      "type": "boolean"
    },
    "recaps": {
      "description": "The week's games retold, same order as games",
      "items": {
        "$ref": "#/$defs/RecapOut"
      },
      "title": "Recaps",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "season": {
      "title": "Season",
      "type": "integer"
    },
    "standings": {
      "description": "Regular season through this week, best record first; seed order in the playoffs",
      "items": {
        "$ref": "#/$defs/StandingLineOut"
      },
      "title": "Standings",
      "type": "array"
    },
    "week": {
      "description": "Matchup period",
      "title": "Week",
      "type": "integer"
    }
  },
  "required": [
    "season",
    "week",
    "label",
    "playoff",
    "periods",
    "games",
    "recaps",
    "headlines",
    "standings",
    "all_play",
    "coaching",
    "draft"
  ],
  "title": "WeekFile",
  "type": "object"
}
