{
  "$defs": {
    "KeeperManagerOut": {
      "additionalProperties": false,
      "properties": {
        "keeps": {
          "title": "Keeps",
          "type": "integer"
        },
        "manager": {
          "title": "Manager",
          "type": "string"
        },
        "seasons": {
          "description": "Keeper seasons the manager was in the league for",
          "title": "Seasons",
          "type": "integer"
        },
        "value": {
          "description": "Total value of the valued keeps",
          "title": "Value",
          "type": "number"
        },
        "valued": {
          "description": "Keeps in finished seasons, which have a value",
          "title": "Valued",
          "type": "integer"
        }
      },
      "required": [
        "manager",
        "keeps",
        "seasons",
        "valued",
        "value"
      ],
      "title": "KeeperManagerOut",
      "type": "object"
    },
    "KeeperOptionOut": {
      "additionalProperties": false,
      "properties": {
        "cost": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The round he would cost before collisions; null if he can't be kept",
          "title": "Cost"
        },
        "kept_in_a_row": {
          "description": "Seasons in a row he has been kept, by anyone, before this draft",
          "title": "Kept In A Row",
          "type": "integer"
        },
        "last_overall": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Overall"
        },
        "last_round": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "His round in last season's draft; null if undrafted",
          "title": "Last Round"
        },
        "player": {
          "title": "Player",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why he can't be kept; null if he can",
          "title": "Reason"
        }
      },
      "required": [
        "player",
        "position",
        "last_round",
        "last_overall",
        "kept_in_a_row",
        "cost",
        "reason"
      ],
      "title": "KeeperOptionOut",
      "type": "object"
    },
    "KeeperOut": {
      "additionalProperties": false,
      "properties": {
        "manager": {
          "title": "Manager",
          "type": "string"
        },
        "overall_pick": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The keeper's pick in that draft; null until it is published",
          "title": "Overall Pick"
        },
        "player": {
          "title": "Player",
          "type": "string"
        },
        "points": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "His season in this league's scoring; null until it is finished",
          "title": "Points"
        },
        "position": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null if ESPN has no record of the player",
          "title": "Position"
        },
        "round": {
          "description": "The draft round the keeper took",
          "title": "Round",
          "type": "integer"
        },
        "run": {
          "description": "How many seasons in a row (any owner) he has been kept, this one included",
          "title": "Run",
          "type": "integer"
        },
        "season": {
          "description": "The season whose draft the player was kept for",
          "title": "Season",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Points above what a normal pick in his slot promised, on the draft page's line for that season (DraftFile); null until the season is finished",
          "title": "Value"
        },
        "via": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The manager who traded his keeper rights in the offseason, if any",
          "title": "Via"
        }
      },
      "required": [
        "season",
        "manager",
        "player",
        "position",
        "round",
        "overall_pick",
        "via",
        "run",
        "points",
        "value"
      ],
      "title": "KeeperOut",
      "type": "object"
    },
    "KeeperPlanOut": {
      "additionalProperties": false,
      "description": "Who each manager can keep for the next draft, and what each would cost.",
      "properties": {
        "from_season": {
          "description": "The season the keepers come from",
          "title": "From Season",
          "type": "integer"
        },
        "from_season_finished": {
          "description": "False: rosters can still change before the draft",
          "title": "From Season Finished",
          "type": "boolean"
        },
        "max_consecutive": {
          "title": "Max Consecutive",
          "type": "integer"
        },
        "min_round": {
          "description": "The earliest round a keeper can have gone in last season",
          "title": "Min Round",
          "type": "integer"
        },
        "rosters": {
          "description": "espn: each team's roster from ESPN when the site was built; season_end: rebuilt from the committed data, which misses moves made after the last one on file",
          "enum": [
            "espn",
            "season_end"
          ],
          "title": "Rosters",
          "type": "string"
        },
        "rosters_as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "When ESPN's rosters were fetched (ISO date); null for season_end",
          "title": "Rosters As Of"
        },
        "season": {
          "description": "The draft being planned",
          "title": "Season",
          "type": "integer"
        },
        "slots": {
          "title": "Slots",
          "type": "integer"
        },
        "teams": {
          "items": {
            "$ref": "#/$defs/KeeperTeamOut"
          },
          "title": "Teams",
          "type": "array"
        }
      },
      "required": [
        "season",
        "from_season",
        "from_season_finished",
        "rosters",
        "rosters_as_of",
        "slots",
        "min_round",
        "max_consecutive",
        "teams"
      ],
      "title": "KeeperPlanOut",
      "type": "object"
    },
    "KeeperTeamOut": {
      "additionalProperties": false,
      "properties": {
        "manager": {
          "title": "Manager",
          "type": "string"
        },
        "name": {
          "description": "The manager's name: he may not be in managers.json yet (no games played)",
          "title": "Name",
          "type": "string"
        },
        "players": {
          "description": "Keepable players by cost, then the rest",
          "items": {
            "$ref": "#/$defs/KeeperOptionOut"
          },
          "title": "Players",
          "type": "array"
        }
      },
      "required": [
        "manager",
        "name",
        "players"
      ],
      "title": "KeeperTeamOut",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Who was kept, from data/manual/keeper_history.yml, and how the keepers played (ESPN).",
  "properties": {
    "keepers": {
      "description": "Every keeper, by season, then manager, then round",
      "items": {
        "$ref": "#/$defs/KeeperOut"
      },
      "title": "Keepers",
      "type": "array"
    },
    "managers": {
      "items": {
        "$ref": "#/$defs/KeeperManagerOut"
      },
      "title": "Managers",
      "type": "array"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/KeeperPlanOut"
        },
        {
          "type": "null"
        }
      ],
      "description": "The next draft's keeper options; null without weekly rosters"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seasons": {
      "description": "Seasons with keepers, oldest first",
      "items": {
        "type": "integer"
      },
      "title": "Seasons",
      "type": "array"
    },
    "slots": {
      "description": "Keepers allowed per team (ESPN keeperCount)",
      "title": "Slots",
      "type": "integer"
    }
  },
  "required": [
    "seasons",
    "slots",
    "keepers",
    "managers",
    "plan"
  ],
  "title": "KeepersFile",
  "type": "object"
}
