          "title": "Value"
        },
        "via": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The manager who traded his keeper rights in the offseason, if any",
          "title": "Via"
        }
      },
      "required": [
        "season",
        "manager",
        "player",
        "position",
        "round",
        "overall_pick",
        "via",
        "run",
        "points",
        "value"
      ],
      "title": "KeeperOut",
      "type": "object"
    }
  },
  "additionalProperties": false,
