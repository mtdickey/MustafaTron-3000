        "$ref": "#/$defs/KeeperOut"
      },
      "title": "Keepers",
      "type": "array"
    },
    "managers": {
      "items": {
        "$ref": "#/$defs/KeeperManagerOut"
      },
      "title": "Managers",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seasons": {
      "description": "Seasons with keepers, oldest first",
      "items": {
        "type": "integer"
      },
      "title": "Seasons",
      "type": "array"
    },
    "slots": {
      "description": "Keepers allowed per team (ESPN keeperCount)",
      "title": "Slots",
      "type": "integer"
    }
  },
  "required": [
    "seasons",
    "slots",
    "keepers",
    "managers"
  ],
  "title": "KeepersFile",
  "type": "object"
